{
  "name": "nihongo-study-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/build-search-index.ts --quiet",
    "dev": "vite grammar-app",
    "prebuild": "tsx scripts/build-search-index.ts",
    "build": "vite build && cp dist/index.html dist/404.html && cp serve.json dist/",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint grammar-app scripts",
    "validate:data": "tsx scripts/validate-content.ts",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "preview": "vite preview",
    "serve": "npx serve dist",
    "start": "npx serve dist",
    "update:models": "tsx scripts/update-model-catalog.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "lucide-react": "^1.33.0",
    "marked": "^18.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
